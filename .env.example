# Copy to .env and fill in. Never commit .env.
# Used by docker-compose.yml (local services) and by apps/server.

# --- Local services (docker compose) ---
POSTGRES_USER=jax
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
S3_PORT=8333
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Server ---
NODE_ENV=development
LOG_LEVEL=info
# Public base URL of the server (used in emails and CORS).
APP_BASE_URL=http://localhost:3000
# Comma-separated origins allowed by CORS (admin portal, Expo web in dev).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Set true only behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false

DATABASE_URL=postgresql://jax:change-me@localhost:5433/jax_dev
TEST_DATABASE_URL=postgresql://jax:change-me@localhost:5433/jax_test

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-32+-random-chars

# D35 personal-data encryption. See docs/KEY_MANAGEMENT.md before changing these.
# Each key is 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEYS lists every master key still needed to read data (comma-separated "id:key").
# Losing these keys makes stored emails unreadable. Back them up separately from the database.
ENCRYPTION_KEYS=v1:replace-with-32-random-bytes-base64
ENCRYPTION_KEY_ID=v1
# Keys the email lookup hash. Must differ from every other secret.
EMAIL_INDEX_KEY=replace-with-32-random-bytes-base64

S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_QUARANTINE=jax-quarantine
S3_BUCKET_MEDIA=jax-media

# Dev seed only: password for dev_alice / dev_bob / dev_admin. Leave empty to skip dev users.
SEED_DEV_PASSWORD=

SMTP_HOST=localhost
SMTP_FROM="Jax App <no-reply@localhost>"
# D90 (optional): also email each Contact us message here. Leave unset to use the admin portal only.
# SUPPORT_INBOX=support@example.com

# Admin portal (D62). Unset = on in development, OFF in production. Keep it off on any
# public server unless you've restricted who can reach it.
# ADMIN_PORTAL_ENABLED=false
