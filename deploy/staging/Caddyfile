# D139 / D245: HTTPS for the app's API. Caddy gets and renews the certificates itself. One server
# runs production (D245): api.jaxside.com for the launch builds, staging-api.jaxside.com kept for
# the test builds already on phones, and the owner website's own block from sites/ (D226).

(api) {
	encode zstd gzip
	# Videos are up to 25 MB (video.maxUploadMB); leave a little room.
	request_body {
		max_size 30MB
	}
	# The admin portal stays off the internet (D62); it's also a 404 in the app.
	@admin path /admin /admin/* /api/v1/admin/*
	respond @admin 404
	reverse_proxy app:3000 {
		# The app trusts the first X-Forwarded-For address (TRUST_PROXY), so replace whatever
		# the client sent with the address Caddy actually saw.
		header_up X-Forwarded-For {remote_host}
	}
	# No access log: email links carry one-time tokens in their URLs.
}

staging-api.jaxside.com {
	import api
}

# D245: the launch address. Its DNS record must point here before this file is deployed
# (step 1 of docs/PRODUCTION_SWITCHOVER.md), or Caddy can't get its certificate.
api.jaxside.com {
	import api
}

# D226 / D243: other sites on this server (the owner website copies jaxside.caddy here).
import sites/*.caddy
