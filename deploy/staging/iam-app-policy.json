{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AppBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": [
        "arn:aws:s3:::jaxside-staging-media",
        "arn:aws:s3:::jaxside-staging-quarantine",
        "arn:aws:s3:::jaxside-staging-backups"
      ]
    },
    {
      "Sid": "AppObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::jaxside-staging-media/*",
        "arn:aws:s3:::jaxside-staging-quarantine/*",
        "arn:aws:s3:::jaxside-staging-backups/*"
      ]
    },
    {
      "Sid": "SendEmail",
      "Effect": "Allow",
      "Action": ["ses:SendRawEmail", "ses:SendEmail"],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "ses:FromAddress": "*@jaxside.com"
        }
      }
    }
  ]
}
