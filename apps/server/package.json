{
  "name": "@jax/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=html --coverage.include=src/server/auth/** --coverage.include=src/server/location/** --coverage.include=src/server/admin/** --coverage.include=src/server/moderation/** --coverage.include=src/server/media/**",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:test:reset": "node scripts/reset-test-db.mjs",
    "fetch:boundary": "tsx scripts/boundary/fetch-duval.ts",
    "import:boundary": "tsx --env-file=../../.env scripts/boundary/import-service-area.ts",
    "jobs:maintenance": "tsx --env-file=../../.env --tsconfig tsconfig.json scripts/jobs/run-maintenance.ts",
    "admin:promote": "tsx --env-file=../../.env --tsconfig tsconfig.json scripts/admin/promote.ts",
    "e2e:live": "tsx --env-file=../../.env --tsconfig tsconfig.json scripts/e2e/live-check.ts",
    "docs:api": "tsx scripts/docs/api-reference.ts",
    "import:places": "tsx --env-file=../../.env --tsconfig tsconfig.json scripts/directory/import-osm.ts",
    "fetch:neighborhoods": "tsx scripts/neighborhoods/fetch-neighborhoods.ts",
    "demo:data": "tsx --env-file=../../.env --tsconfig tsconfig.json scripts/dev/demo-data.ts",
    "fetch:map": "tsx --tsconfig tsconfig.json scripts/map/fetch-map.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@jax/shared": "*",
    "@next/env": "16.4.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "16.4.1",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/shapefile": "^0.6.4",
    "@vitest/coverage-v8": "^5.0.4",
    "fflate": "^0.8.3",
    "prisma": "^7.10.1",
    "shapefile": "^0.6.6",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
