// Jax App schema (§16, D5). Conventions:
// - IDs are UUIDv7 (time-ordered, not guessable enough to matter; never rely on ID secrecy).
// - Geography columns are Unsupported(...) and written via parameterized raw SQL (src/server/db/geo.ts).
// - "Exactly one of" rules for polymorphic targets/authors are CHECK constraints in migration SQL.
// - Timestamps are timestamptz.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  /// P13.1 / D109: partial indexes in the schema, so migrations never see them as drift.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum SessionKind {
  MOBILE
  ADMIN
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum GuestStatus {
  ACTIVE
  EXPIRED
  BANNED
}

enum AuthorKind {
  USER
  GUEST
  BUSINESS // D172: the place's business, through the business website
}

enum ContentStatus {
  VISIBLE
  HELD_FOR_REVIEW
  REMOVED // by moderation
  DELETED // by author
}

enum PlaceStatus {
  ACTIVE
  INACTIVE
  /// D94: taken down by community vote (or an admin); the OSM import never brings it back.
  REMOVED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  DUPLICATE
  MERGED
  /// D94: not enough votes within the voting window.
  EXPIRED
}

enum PhotoStatus {
  PENDING_UPLOAD
  PROCESSING
  ACTIVE
  REJECTED
  REMOVED
}

enum ReportReason {
  SPAM
  HARASSMENT
  THREAT
  HATE
  DOXXING
  SEXUAL_CONTENT
  CHILD_SAFETY
  IMPERSONATION
  SCAM
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum ModerationActionType {
  NOTE
  WARN
  SUSPEND
  BAN
  UNBAN
  REMOVE_CONTENT
  RESTORE_CONTENT
  ADJUST_RATE_LIMIT
  LOCATION_RESTRICT
}

enum DeletionStatus {
  REQUESTED
  PROCESSING
  COMPLETED
}

/// P2.6: why a location pattern was flagged for review.
enum LocationFlagKind {
  IMPOSSIBLE_TRAVEL // blocked + temporary restriction
  SUSPICIOUS_TRAVEL // flag only
  MOCKED_LOCATION
}

enum LocationCheckResult {
  ALLOWED
  DENIED
}

// ──────────────────────── Identity & sessions ────────────────────────

model User {
  id                 String        @id @default(uuid(7)) @db.Uuid
  username           String        @db.VarChar(20)
  usernameNormalized String        @unique @db.VarChar(20)
  usernameChangedAt  DateTime?     @db.Timestamptz(3)
  emailVerifiedAt    DateTime?     @db.Timestamptz(3)
  /// argon2id hash. Never in any response.
  passwordHash       String
  role               Role          @default(USER)
  /// D141: shows ADMIN under the name on posts, comments and the profile. Set in the admin
  /// portal; it gives no admin access (that's `role`, set only by the promote command).
  staffBadge         Boolean       @default(false)
  status             AccountStatus @default(ACTIVE)
  suspendedUntil     DateTime?     @db.Timestamptz(3)
  deletedAt          DateTime?     @db.Timestamptz(3)
  tosAcceptedAt      DateTime      @db.Timestamptz(3)
  tosVersion         String        @db.VarChar(20)
  adultConfirmedAt   DateTime      @db.Timestamptz(3)
  /// D36: the user attested being born in or before this year (policy record; birth year itself is not stored).
  ageCutoffYear      Int           @db.SmallInt
  /// D35: keyed hash of the normalized email, for lookup and uniqueness. Kept for banned accounts after shredding (D37).
  emailIndex         String?       @unique @db.Char(64)
  /// D35: email encrypted with the user's data key (AES-256-GCM). Null after crypto-shredding (D37).
  emailEnc           Bytes?
  /// D35: the user's random data key, wrapped by a master key. Destroying it makes emailEnc unreadable (D37).
  dekWrapped         Bytes?
  /// D37: legal hold. While set, the account's encrypted data is never shredded.
  legalHoldAt        DateTime?     @db.Timestamptz(3)
  legalHoldNote      String?       @db.VarChar(500)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  profile         Profile?
  /// D108: preferences and admin 2FA live in their own tables.
  settings        UserSettings?
  adminCredential AdminCredential?
  sessions        Session[]
  emailTokens     EmailToken[]
  usernameHistory UsernameHistory[]
  generalPosts    GeneralPost[]
  businessPosts   BusinessPost[]
  comments        Comment[]
  votes           Vote[]
  photos          Photo[]
  favorites       FavoritePlace[]
  placeRatings    PlaceRating[]
  appeals         Appeal[]             @relation("Appellant")
  achievements    UserAchievement[]
  pollsCreated    Poll[]               @relation("PollCreator")
  topicsSuggested CityTopic[]          @relation("TopicSuggester")
  topicsCreated   CityTopic[]          @relation("TopicCreator")
  topicFollows    TopicFollow[]
  pollSuggestions PollSuggestion[]
  submissions     BusinessSubmission[] @relation("Submitter")
  reviewedSubs    BusinessSubmission[] @relation("Reviewer")
  reportsMade     Report[]             @relation("Reporter")
  reportsAgainst  Report[]             @relation("ReportedUser")
  reportsResolved Report[]             @relation("ReportResolver")
  blocking        UserBlock[]          @relation("Blocker")
  blockedBy       UserBlock[]          @relation("Blocked")
  modActionsTaken ModerationAction[]   @relation("ModActor")
  modActionsOnMe  ModerationAction[]   @relation("ModTargetUser")
  auditLogs       AdminAuditLog[]
  deletions       AccountDeletion[]
  locationChecks  LocationCheck[]
  locationFlags   LocationFlag[]       @relation("LocationFlagUser")
  flagsReviewed   LocationFlag[]       @relation("LocationFlagReviewer")
  configUpdates   AppConfiguration[]

  autoSuspensions AutoSuspension[]

  friendshipsLow      Friendship[]   @relation("FriendLow")
  friendshipsHigh     Friendship[]   @relation("FriendHigh")
  friendRequestsSent  Friendship[]   @relation("FriendRequester")
  notifications       Notification[] @relation("NotificationFor")
  notificationsCaused Notification[] @relation("NotificationActor")

  contactMessages ContactMessage[] @relation("ContactFrom")
  contactResolved ContactMessage[] @relation("ContactResolvedBy")

  placeRemovals     PlaceRemoval[]    @relation("RemovalRequester")
  placeRemovalsDone PlaceRemoval[]    @relation("RemovalResolver")
  placeVotes        PlaceChangeVote[] @relation("PlaceVoter")

  conversationsLow    Conversation[]       @relation("ConversationLow")
  conversationsHigh   Conversation[]       @relation("ConversationHigh")
  conversationMembers ConversationMember[] @relation("ConversationMembership")
  messagesSent        Message[]            @relation("MessageSender")
  messagesHidden      MessageHide[]        @relation("MessageHidden")

  ownerClaims        OwnerClaim[] @relation("OwnerClaimant")
  ownerClaimsDecided OwnerClaim[] @relation("OwnerClaimDecider")

  guidesSeen GuideSeen[] @relation("GuidesSeen")

  securityEvents SecurityEvent[]

  activeDays       UserActiveDay[]
  giveawaysCreated Giveaway[]       @relation("GiveawayCreator")
  giveawayWins     GiveawayWinner[] @relation("GiveawayWins")
  giveawayPicks    GiveawayWinner[] @relation("GiveawayPicker")

  @@index([status])
}

model UsernameHistory {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  username  String   @db.VarChar(20)
  changedAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, changedAt])
}

/// Server-managed opaque sessions (D3). Only the SHA-256 of the token is stored.
model Session {
  id             String        @id @default(uuid(7)) @db.Uuid
  tokenHash      String        @unique @db.Char(64)
  userId         String        @db.Uuid
  kind           SessionKind
  /// Admin sessions only: hash of the CSRF token (D3).
  csrfTokenHash  String?       @db.Char(64)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  lastUsedAt     DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime      @db.Timestamptz(3)
  revokedAt      DateTime?     @db.Timestamptz(3)
  /// P2.7: the app install that signed in (for ban carry-over and abuse review).
  installationId String?       @db.Uuid
  installation   Installation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([installationId])
}

/// Single-use email tokens (verification, reset, email change). Hashed (D10).
model EmailToken {
  id            String            @id @default(uuid(7)) @db.Uuid
  userId        String            @db.Uuid
  purpose       EmailTokenPurpose
  tokenHash     String            @unique @db.Char(64)
  /// EMAIL_CHANGE only: the new address, encrypted with the user's data key (D35).
  newEmailEnc   Bytes?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime          @db.Timestamptz(3)
  usedAt        DateTime?         @db.Timestamptz(3)
  /// D31: 6-digit code typed into the app. HMAC (server secret) of the code, never the code.
  codeHash      String?           @db.Char(64)
  codeExpiresAt DateTime?         @db.Timestamptz(3)
  /// Wrong code entries; the token dies at emailCode.maxAttempts.
  codeAttempts  Int               @default(0)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// Server-issued installation ID (§6.2, P2.7). Not a hardware identifier.
model Installation {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// P2.7: SHA-256 of the secret installation token the app holds. Never the token.
  tokenHash       String    @unique @db.Char(64)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt      DateTime  @default(now()) @db.Timestamptz(3)
  bannedAt        DateTime? @db.Timestamptz(3)
  integrityStatus String?   @db.VarChar(32)

  guestSessions  GuestSession[]
  modActions     ModerationAction[]
  locationChecks LocationCheck[]
  sessions       Session[]
}

model GuestSession {
  id             String       @id @default(uuid(7)) @db.Uuid
  tokenHash      String       @unique @db.Char(64)
  installationId String       @db.Uuid
  status         GuestStatus  @default(ACTIVE)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  lastActiveAt   DateTime     @default(now()) @db.Timestamptz(3)
  /// lastActiveAt + guest.inactivityDays, recomputed on activity.
  expiresAt      DateTime     @db.Timestamptz(3)
  bannedAt       DateTime?    @db.Timestamptz(3)
  installation   Installation @relation(fields: [installationId], references: [id])

  comments        Comment[]
  reports         Report[]
  modActions      ModerationAction[]
  locationChecks  LocationCheck[]
  locationFlags   LocationFlag[]
  contactMessages ContactMessage[]

  @@index([installationId])
  @@index([status, expiresAt])
}

model Profile {
  userId        String   @id @db.Uuid
  /// D69 / D108: account color key (palette in @jax/shared). Random at sign-up; changeable.
  color         String   @default("teal") @db.VarChar(20)
  bio           String?  @db.VarChar(300)
  avatarPhotoId String?  @unique @db.Uuid
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarPhoto   Photo?   @relation("Avatar", fields: [avatarPhotoId], references: [id], onDelete: SetNull)
}

/// D108: a person's private preferences. No row = all defaults.
model UserSettings {
  userId               String   @id @db.Uuid
  /// User-chosen radii in miles; null = config default. Clamped server-side (P2.15).
  generalRadiusMiles   Float?
  businessRadiusMiles  Float?
  /// D76: left out of the friends feed.
  hidePostsFromFriends Boolean  @default(false)
  /// D116: left out of the anonymous area statistics (Account → Settings).
  areaStatsOptOut      Boolean  @default(false)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// D108: an admin's 2FA, apart from the User row that every request reads. Only admins have one.
model AdminCredential {
  userId        String    @id @db.Uuid
  /// Admin TOTP secret, encrypted at rest (D4).
  totpSecretEnc String?
  totpEnabledAt DateTime? @db.Timestamptz(3)
  /// P5.11: the last 30-second step whose code was accepted, so a code can't be reused.
  totpLastStep  Int?
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Location ─────────────────────────────

/// The eligible service area polygon (D15: Duval County). Swappable.
model ServiceArea {
  id            String                                        @id @default(uuid(7)) @db.Uuid
  key           String                                        @unique @db.VarChar(50)
  name          String
  sourceUrl     String
  sourceVersion String
  license       String
  active        Boolean                                       @default(true)
  geom          Unsupported("geography(MultiPolygon, 4326)")?
  importedAt    DateTime                                      @default(now()) @db.Timestamptz(3)

  @@index([geom], type: Gist)
}

/// Precise location audit (D7). Restricted access; purged after location retention (D14).
model LocationCheck {
  id             String                                 @default(uuid(7)) @db.Uuid
  userId         String?                                @db.Uuid
  guestSessionId String?                                @db.Uuid
  installationId String?                                @db.Uuid
  action         String                                 @db.VarChar(40)
  point          Unsupported("geography(Point, 4326)")?
  accuracyMeters Float
  readingAt      DateTime                               @db.Timestamptz(3)
  receivedAt     DateTime                               @default(now()) @db.Timestamptz(3)
  result         LocationCheckResult
  reason         String?                                @db.VarChar(40)
  user           User?                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession   GuestSession?                          @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  installation   Installation?                          @relation(fields: [installationId], references: [id], onDelete: SetNull)

  /// P13.6 (D106): partitioned by day on receivedAt (raw SQL; pieces in schema jax_partitions,
  /// which Prisma doesn't see). The partition key must be part of the primary key.
  @@id([id, receivedAt])
  @@index([userId, receivedAt])
  @@index([guestSessionId, receivedAt])
  @@index([receivedAt])
  // P13.1: foreign-key indexes (deletes of the parent row would otherwise read the whole table)
  @@index([installationId])
}

/// P2.6: suspicious location patterns for admin review (no coordinates stored here).
model LocationFlag {
  id              String           @id @default(uuid(7)) @db.Uuid
  userId          String?          @db.Uuid
  guestSessionId  String?          @db.Uuid
  kind            LocationFlagKind
  action          String           @db.VarChar(40)
  speedKmh        Float?
  distanceKm      Float?
  elapsedSeconds  Float?
  /// Location-restricted actions are refused until this time.
  restrictedUntil DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  reviewedAt      DateTime?        @db.Timestamptz(3)
  reviewedById    String?          @db.Uuid
  user            User?            @relation("LocationFlagUser", fields: [userId], references: [id], onDelete: Cascade)
  guestSession    GuestSession?    @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  reviewedBy      User?            @relation("LocationFlagReviewer", fields: [reviewedById], references: [id])

  @@index([userId, createdAt])
  @@index([guestSessionId, createdAt])
  @@index([reviewedAt, createdAt])
  // P13.1: foreign-key indexes (deletes of the parent row would otherwise read the whole table)
  @@index([reviewedById])
}

// ──────────────────────────── Directory ────────────────────────────

model BusinessPlace {
  id              String                                 @id @default(uuid(7)) @db.Uuid
  name            String                                 @db.VarChar(200)
  nameNormalized  String                                 @db.VarChar(200)
  category        String                                 @db.VarChar(60)
  address         String?                                @db.VarChar(300)
  /// D103: the business's public website and phone from the map data (owner verification).
  website         String?                                @db.VarChar(300)
  phone           String?                                @db.VarChar(40)
  latitude        Float
  longitude       Float
  /// Generated from latitude/longitude in raw SQL on write.
  location        Unsupported("geography(Point, 4326)")?
  status          PlaceStatus                            @default(ACTIVE)
  /// Visible business-room posts, maintained in the same transaction as each post (D41).
  postCount       Int                                    @default(0)
  /// D144: likes and dislikes (PlaceRating), maintained in the same transaction as each vote.
  likeCount       Int                                    @default(0)
  dislikeCount    Int                                    @default(0)
  /// D144: an admin locked voting here (abuse); existing votes stay unless cleared.
  ratingsLockedAt DateTime?                              @db.Timestamptz(3)
  sourceName      String                                 @db.VarChar(40)
  sourceId        String                                 @db.VarChar(100)
  attribution     String?                                @db.VarChar(200)
  createdAt       DateTime                               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                               @updatedAt @db.Timestamptz(3)

  posts       BusinessPost[]
  favorites   FavoritePlace[]
  ratings     PlaceRating[]
  submissions BusinessSubmission[]

  removals    PlaceRemoval[]
  ownerClaims OwnerClaim[]
  placeStats  PlaceStatsDaily[]

  // D169: business portal (no columns here; the business tables point at the place).
  businessAccess       BusinessPlaceAccess[]
  businessInvites      BusinessInvite[]
  ads                  Ad[]
  businessNotices      BusinessNotice[]
  verificationRequests BusinessVerificationRequest[]

  @@unique([sourceName, sourceId])
  @@index([location], type: Gist)
  @@index([nameNormalized(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([status, category])
}

/// D94: a community request to take a place down ("closed / doesn't exist").
enum PlaceRemovalStatus {
  OPEN
  REMOVED // enough "closed" votes (or an admin)
  KEPT // enough "still open" votes, or an admin restored the place
  EXPIRED
}

model PlaceRemoval {
  id           String             @id @default(uuid(7)) @db.Uuid
  placeId      String             @db.Uuid
  requesterId  String             @db.Uuid
  status       PlaceRemovalStatus @default(OPEN)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  resolvedAt   DateTime?          @db.Timestamptz(3)
  /// Set when an admin decided it (null for a community result).
  resolvedById String?            @db.Uuid
  place        BusinessPlace      @relation(fields: [placeId], references: [id], onDelete: Cascade)
  requester    User               @relation("RemovalRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  resolvedBy   User?              @relation("RemovalResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  votes        PlaceChangeVote[]

  /// One open removal vote per place (was raw SQL; D109).
  @@unique([placeId], map: "PlaceRemoval_one_open_per_place", where: raw("status = 'OPEN'"))
  @@index([status, createdAt])
  @@index([placeId])
  // P13.1: foreign-key indexes (deletes of the parent row would otherwise read the whole table)
  @@index([requesterId])
  @@index([resolvedById])
}

/// D94: one vote per person per change, kept for the admin to review. `support` means
/// "it's here" for a suggestion, or "it's closed" for a removal.
model PlaceChangeVote {
  id             String              @id @default(uuid(7)) @db.Uuid
  voterId        String              @db.Uuid
  submissionId   String?             @db.Uuid
  removalId      String?             @db.Uuid
  support        Boolean
  /// How far the voter was from the spot when voting.
  distanceMeters Int
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  voter          User                @relation("PlaceVoter", fields: [voterId], references: [id], onDelete: Cascade)
  submission     BusinessSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  removal        PlaceRemoval?       @relation(fields: [removalId], references: [id], onDelete: Cascade)

  @@unique([voterId, submissionId])
  @@unique([voterId, removalId])
  @@index([submissionId])
  @@index([removalId])
}

/// D103: verified business owners (D92). How a claim is checked, and where it stands.
enum OwnerMethod {
  EMAIL // a code to an address at the business's own web domain (automatic)
  WEBSITE // a code the owner posts on the business's site or social page (admin checks)
  PHONE // an admin calls the business's public number and reads a code
  TEAM // D157: added to the owner team by the place's primary owner
}

enum OwnerClaimStatus {
  PENDING // waiting for the code or an admin
  VERIFIED // the person is a verified owner of the place
  REJECTED
  REVOKED // the Owner tag was taken away (misuse)
  CANCELLED // withdrawn by the person
}

model OwnerClaim {
  id              String                @id @default(uuid(7)) @db.Uuid
  placeId         String                @db.Uuid
  userId          String                @db.Uuid
  method          OwnerMethod
  status          OwnerClaimStatus      @default(PENDING)
  /// EMAIL: only the domain is kept (the address is used once, to send the code).
  emailDomain     String?               @db.VarChar(200)
  /// EMAIL / PHONE: the code to enter, hashed; expires; limited tries.
  codeHash        String?               @db.VarChar(100)
  codeExpiresAt   DateTime?             @db.Timestamptz(3)
  attempts        Int                   @default(0)
  /// WEBSITE: the code to post publicly, and where the owner says they posted it.
  publicCode      String?               @db.VarChar(20)
  proofUrl        String?               @db.VarChar(500)
  /// PHONE: the code an admin reads out (shown in the portal only).
  phoneCode       String?               @db.VarChar(10)
  note            String?               @db.VarChar(500)
  /// D157: the place's primary owner (the first verified): manages the owner team.
  primary         Boolean               @default(false)
  /// D157: shown instead of a username ("The Owner · Sarah"); optional.
  staffName       String?               @db.VarChar(30)
  /// D157: the primary owner who added this team member (TEAM claims).
  addedById       String?               @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  verifiedAt      DateTime?             @db.Timestamptz(3)
  decidedAt       DateTime?             @db.Timestamptz(3)
  decidedById     String?               @db.Uuid
  place           BusinessPlace         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user            User                  @relation("OwnerClaimant", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy       User?                 @relation("OwnerClaimDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  /// D169: the business-portal invite and access this verified claim led to (B1.3).
  businessInvites BusinessInvite[]
  businessAccess  BusinessPlaceAccess[]

  /// One open claim per person and place (was raw SQL; D109).
  @@unique([placeId, userId], map: "OwnerClaim_one_open", where: raw("status = 'PENDING'"))
  /// D157: one primary owner per place.
  @@unique([placeId], map: "OwnerClaim_one_primary", where: raw("\"primary\" AND status = 'VERIFIED'"))
  @@index([placeId, status])
  @@index([userId, status])
  @@index([status, createdAt])
  // P13.1: foreign-key indexes (deletes of the parent row would otherwise read the whole table)
  @@index([decidedById])
}

model BusinessSubmission {
  id             String                                 @id @default(uuid(7)) @db.Uuid
  submitterId    String                                 @db.Uuid
  name           String                                 @db.VarChar(200)
  nameNormalized String                                 @db.VarChar(200)
  category       String                                 @db.VarChar(60)
  address        String?                                @db.VarChar(300)
  latitude       Float
  longitude      Float
  location       Unsupported("geography(Point, 4326)")?
  notes          String?                                @db.VarChar(1000)
  status         SubmissionStatus                       @default(PENDING)
  decisionReason String?                                @db.VarChar(500)
  reviewerId     String?                                @db.Uuid
  reviewedAt     DateTime?                              @db.Timestamptz(3)
  /// Place created on approval, or the existing place it was merged into.
  placeId        String?                                @db.Uuid
  createdAt      DateTime                               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                               @updatedAt @db.Timestamptz(3)
  submitter      User                                   @relation("Submitter", fields: [submitterId], references: [id])
  reviewer       User?                                  @relation("Reviewer", fields: [reviewerId], references: [id])
  place          BusinessPlace?                         @relation(fields: [placeId], references: [id])

  modActions ModerationAction[]
  votes      PlaceChangeVote[]

  @@index([status, createdAt])
  @@index([submitterId, createdAt])
  @@index([location], type: Gist)
  // P13.1: foreign-key indexes (deletes of the parent row would otherwise read the whole table)
  @@index([placeId])
  @@index([reviewerId])
}

/// D144: one like or dislike per person per place, given only while there. Changing it
/// updates this row; the place's likeCount / dislikeCount move in the same transaction.
model PlaceRating {
  placeId   String        @db.Uuid
  userId    String        @db.Uuid
  /// +1 liked, -1 didn't (a CHECK constraint keeps it to those).
  value     Int           @db.SmallInt
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  place     BusinessPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([placeId, userId])
  @@index([userId])
  /// The admin Ratings page: recent votes per place (abuse spikes).
  @@index([updatedAt])
}

model FavoritePlace {
  userId    String        @db.Uuid
  placeId   String        @db.Uuid
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     BusinessPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
  @@index([placeId])
}

// ─────────────────────────── Discussions ───────────────────────────

/// General feed post (§7.1). Registered users only, so the author is always a User.
model GeneralPost {
  id              String                                 @id @default(uuid(7)) @db.Uuid
  authorId        String                                 @db.Uuid
  body            String                                 @db.VarChar(2000)
  /// Coarsened (~100 m grid) point assigned by the server (D7). Never the raw reading.
  location        Unsupported("geography(Point, 4326)")?
  status          ContentStatus                          @default(VISIBLE)
  score           Int                                    @default(0)
  upCount         Int                                    @default(0)
  downCount       Int                                    @default(0)
  commentCount    Int                                    @default(0)
  createdAt       DateTime                               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                               @updatedAt @db.Timestamptz(3)
  editedAt        DateTime?                              @db.Timestamptz(3)
  /// D107: when the status last changed (set by a database trigger); retention counts from it.
  statusChangedAt DateTime?                              @db.Timestamptz(3)
  /// D125: set for a post in a citywide topic (kept out of the local feed).
  topicId         String?                                @db.Uuid
  author          User                                   @relation(fields: [authorId], references: [id])
  topic           CityTopic?                             @relation(fields: [topicId], references: [id], onDelete: Restrict)

  comments   Comment[]
  votes      Vote[]
  photos     Photo[]
  reports    Report[]
  modActions ModerationAction[]

  notifications Notification[] // D156

  @@index([location], type: Gist)
  /// D125: a topic's posts, newest first.
  @@index([topicId, status, createdAt(sort: Desc), id(sort: Desc)], where: raw("\"topicId\" IS NOT NULL"))
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  // P13.7: the retention purge of deleted / removed content
  @@index([statusChangedAt], where: raw("\"statusChangedAt\" IS NOT NULL"))
}

/// Business room post (§7.2). Always tied to one canonical place.
/// D172: written by a phone-app user (authorId) or by the place's business through the
/// business website (businessAuthorId); exactly one of the two (CHECK). A business post
/// always shows as "The Owner".
model BusinessPost {
  id               String           @id @default(uuid(7)) @db.Uuid
  placeId          String           @db.Uuid
  authorId         String?          @db.Uuid
  businessAuthorId String?          @db.Uuid
  body             String           @db.VarChar(2000)
  status           ContentStatus    @default(VISIBLE)
  score            Int              @default(0)
  upCount          Int              @default(0)
  downCount        Int              @default(0)
  commentCount     Int              @default(0)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  editedAt         DateTime?        @db.Timestamptz(3)
  /// D107: when the status last changed (set by a database trigger); retention counts from it.
  statusChangedAt  DateTime?        @db.Timestamptz(3)
  place            BusinessPlace    @relation(fields: [placeId], references: [id])
  author           User?            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  businessAuthor   BusinessAccount? @relation(fields: [businessAuthorId], references: [id], onDelete: Restrict)

  comments   Comment[]
  votes      Vote[]
  photos     Photo[]
  reports    Report[]
  modActions ModerationAction[]

  notifications Notification[] // D156

  @@index([placeId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([businessAuthorId])
  // P13.7: the retention purge of deleted / removed content
  @@index([statusChangedAt], where: raw("\"statusChangedAt\" IS NOT NULL"))
}

/// Comment on exactly one post (CHECK). Author is a User, a Guest or (D172) the place's
/// business (authorKind; CHECK). authorGuestId may become null after guest data purge;
/// authorKind keeps the GUEST label (§16).
model Comment {
  id               String           @id @default(uuid(7)) @db.Uuid
  generalPostId    String?          @db.Uuid
  businessPostId   String?          @db.Uuid
  parentCommentId  String?          @db.Uuid
  depth            Int              @default(0) @db.SmallInt
  authorKind       AuthorKind
  authorUserId     String?          @db.Uuid
  authorGuestId    String?          @db.Uuid
  /// D172: a reply from the business website (business posts only; shows as "The Owner").
  authorBusinessId String?          @db.Uuid
  body             String           @db.VarChar(1000)
  status           ContentStatus    @default(VISIBLE)
  score            Int              @default(0)
  upCount          Int              @default(0)
  downCount        Int              @default(0)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  editedAt         DateTime?        @db.Timestamptz(3)
  /// D107: when the status last changed (set by a database trigger); retention counts from it.
  statusChangedAt  DateTime?        @db.Timestamptz(3)
  generalPost      GeneralPost?     @relation(fields: [generalPostId], references: [id], onDelete: Cascade)
  businessPost     BusinessPost?    @relation(fields: [businessPostId], references: [id], onDelete: Cascade)
  parent           Comment?         @relation("Thread", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies          Comment[]        @relation("Thread")
  authorUser       User?            @relation(fields: [authorUserId], references: [id])
  authorGuest      GuestSession?    @relation(fields: [authorGuestId], references: [id], onDelete: SetNull)
  authorBusiness   BusinessAccount? @relation(fields: [authorBusinessId], references: [id], onDelete: Restrict)

  votes      Vote[]
  reports    Report[]
  modActions ModerationAction[]

  notifications Notification[] // D156

  @@index([generalPostId, createdAt, id])
  @@index([businessPostId, createdAt, id])
  @@index([parentCommentId])
  @@index([authorUserId, createdAt(sort: Desc)])
  @@index([authorGuestId])
  @@index([authorBusinessId])
  // P13.1: the guest-comment purge only
  @@index([createdAt], where: raw("\"authorKind\" = 'GUEST'"))
  // P13.7: the retention purge of deleted / removed content
  @@index([statusChangedAt], where: raw("\"statusChangedAt\" IS NOT NULL"))
}

/// One vote per (voter, target) regardless of direction (D6). Value is +1 or -1 (CHECK).
model Vote {
  id             String        @id @default(uuid(7)) @db.Uuid
  voterId        String        @db.Uuid
  generalPostId  String?       @db.Uuid
  businessPostId String?       @db.Uuid
  commentId      String?       @db.Uuid
  value          Int           @db.SmallInt
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  voter          User          @relation(fields: [voterId], references: [id], onDelete: Cascade)
  generalPost    GeneralPost?  @relation(fields: [generalPostId], references: [id], onDelete: Cascade)
  businessPost   BusinessPost? @relation(fields: [businessPostId], references: [id], onDelete: Cascade)
  comment        Comment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([voterId, generalPostId])
  @@unique([voterId, businessPostId])
  @@unique([voterId, commentId])
  // P13.1: foreign-key indexes (deletes of the parent row would otherwise read the whole table)
  @@index([generalPostId])
  @@index([businessPostId])
  @@index([commentId])
}

/// Image record. Bytes live in object storage only (§12).
/// D75: what an uploaded media item is. The Photo table holds all post media.
enum MediaKind {
  IMAGE
  AUDIO // voice posts
  VIDEO // reserved for video posts (P8.9)
}

/// Uploaded media: photos, GIFs and voice clips (D65, D74, D75).
model Photo {
  id             String        @id @default(uuid(7)) @db.Uuid
  uploaderId     String        @db.Uuid
  kind           MediaKind     @default(IMAGE)
  /// Voice clips: length in milliseconds (checked by the server).
  durationMs     Int?
  /// Random key in the private media bucket (set after processing).
  storageKey     String?       @unique @db.VarChar(200)
  quarantineKey  String?       @unique @db.VarChar(200)
  status         PhotoStatus   @default(PENDING_UPLOAD)
  mimeType       String?       @db.VarChar(40)
  width          Int?
  height         Int?
  bytes          Int?
  generalPostId  String?       @db.Uuid
  businessPostId String?       @db.Uuid
  /// D98: a photo sent in a private message.
  messageId      String?       @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  processedAt    DateTime?     @db.Timestamptz(3)
  removedAt      DateTime?     @db.Timestamptz(3)
  uploader       User          @relation(fields: [uploaderId], references: [id])
  generalPost    GeneralPost?  @relation(fields: [generalPostId], references: [id], onDelete: SetNull)
  businessPost   BusinessPost? @relation(fields: [businessPostId], references: [id], onDelete: SetNull)
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  avatarOf       Profile?      @relation("Avatar")

  reports    Report[]
  modActions ModerationAction[]

  @@index([uploaderId, createdAt])
  @@index([generalPostId])
  @@index([businessPostId])
  @@index([messageId])
  @@index([status, createdAt])
}

// ─────────────────────────── Achievements ───────────────────────────

model Achievement {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(80)
  description String   @db.VarChar(300)
  icon        String   @db.VarChar(50)
  criteria    Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  awards UserAchievement[]
}

model UserAchievement {
  userId        String      @db.Uuid
  achievementId String      @db.Uuid
  awardedAt     DateTime    @default(now()) @db.Timestamptz(3)
  /// D122: 1 Bronze, 2 Silver, 3 Gold, 4 Platinum. Only goes up.
  tier          Int         @default(1) @db.SmallInt
  /// D122: when the current level was reached (null while still at the first level).
  tierAt        DateTime?   @db.Timestamptz(3)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@id([userId, achievementId])
  // P13.1: foreign-key indexes (deletes of the parent row would otherwise read the whole table)
  @@index([achievementId])
}

// ──────────────────────── Safety & moderation ────────────────────────

/// Report against exactly one target (CHECK). Reporter is a User or Guest (CHECK).
model Report {
  id                 String           @id @default(uuid(7)) @db.Uuid
  reporterUserId     String?          @db.Uuid
  reporterGuestId    String?          @db.Uuid
  /// D194: a business login reported it (website, its own place's discussion). Goes to the
  /// admin queue only: never counts toward auto-hide (D73) or auto-suspend (D74).
  reporterBusinessId String?          @db.Uuid
  generalPostId      String?          @db.Uuid
  businessPostId     String?          @db.Uuid
  commentId          String?          @db.Uuid
  photoId            String?          @db.Uuid
  reportedUserId     String?          @db.Uuid
  /// D98: a reported private message (null once it's unsent or its sender deleted).
  messageId          String?          @db.Uuid
  /// D133: a reported topic (its title or description).
  cityTopicId        String?          @db.Uuid
  /// D98: snapshot of the reported message and the 10 around it, kept 1 year as evidence.
  messageEvidence    Json?
  reason             ReportReason
  details            String?          @db.VarChar(1000)
  status             ReportStatus     @default(OPEN)
  resolvedById       String?          @db.Uuid
  resolvedAt         DateTime?        @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  reporterUser       User?            @relation("Reporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reporterGuest      GuestSession?    @relation(fields: [reporterGuestId], references: [id], onDelete: SetNull)
  reporterBusiness   BusinessAccount? @relation("BusinessReporter", fields: [reporterBusinessId], references: [id], onDelete: SetNull)
  generalPost        GeneralPost?     @relation(fields: [generalPostId], references: [id], onDelete: Cascade)
  businessPost       BusinessPost?    @relation(fields: [businessPostId], references: [id], onDelete: Cascade)
  comment            Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  photo              Photo?           @relation(fields: [photoId], references: [id], onDelete: Cascade)
  message            Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  cityTopic          CityTopic?       @relation(fields: [cityTopicId], references: [id], onDelete: Cascade)
  reportedUser       User?            @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  resolvedBy         User?            @relation("ReportResolver", fields: [resolvedById], references: [id])

  modActions ModerationAction[]

  @@index([status, createdAt])
  @@index([generalPostId])
  @@index([businessPostId])
  @@index([commentId])
  @@index([photoId])
  @@index([reportedUserId])
  @@index([reporterBusinessId, createdAt])
  // P13.1: foreign-key indexes (deletes of the parent row would otherwise read the whole table)
  @@index([messageId])
  @@index([cityTopicId])
  @@index([reporterUserId, createdAt])
  @@index([reporterGuestId])
  @@index([resolvedById])
}

/// D76: friendships are mutual and by request. One row per pair (low id, high id), so
/// two people can't have two rows; `requesterId` says who asked.
enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          String           @id @default(uuid(7)) @db.Uuid
  userLowId   String           @db.Uuid
  userHighId  String           @db.Uuid
  requesterId String           @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  acceptedAt  DateTime?        @db.Timestamptz(3)
  userLow     User             @relation("FriendLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh    User             @relation("FriendHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  requester   User             @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userHighId, status])
  @@index([requesterId, status])
}

/// D76: in-app notifications (the bell). Kept small: type + who caused it.
enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  /// D156: someone commented on your post (unread ones on the same post are combined).
  POST_COMMENT
  /// D156: someone replied to your comment.
  COMMENT_REPLY
  /// D156: someone wrote @you in a post or comment.
  MENTION
  /// D188: you won a giveaway; open it to accept or decline the prize.
  GIVEAWAY_WIN
}

model Notification {
  id               String           @id @default(uuid(7)) @db.Uuid
  userId           String           @db.Uuid
  type             NotificationType
  actorId          String?          @db.Uuid
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  readAt           DateTime?        @db.Timestamptz(3)
  /// D156: the post (and comment) a comment, reply or mention notification points to.
  generalPostId    String?          @db.Uuid
  businessPostId   String?          @db.Uuid
  commentId        String?          @db.Uuid
  /// D156: unread comments on one post are one row ("5 new comments").
  count            Int              @default(1)
  user             User             @relation("NotificationFor", fields: [userId], references: [id], onDelete: Cascade)
  actor            User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  /// D172: the place's business answered (business website); shown as "The Owner".
  actorBusinessId  String?          @db.Uuid
  actorBusiness    BusinessAccount? @relation(fields: [actorBusinessId], references: [id], onDelete: Cascade)
  generalPost      GeneralPost?     @relation(fields: [generalPostId], references: [id], onDelete: Cascade)
  businessPost     BusinessPost?    @relation(fields: [businessPostId], references: [id], onDelete: Cascade)
  comment          Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  /// D188: the giveaway win this notification is about (no actor: it comes from JaxSide).
  giveawayWinnerId String?          @db.Uuid
  giveawayWinner   GiveawayWinner?  @relation(fields: [giveawayWinnerId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  // P13.1: the unread bell count; createdAt for the purge
  @@index([userId], where: raw("\"readAt\" IS NULL"))
  @@index([createdAt])
  // P13.1: foreign-key indexes (deletes of the parent row would otherwise read the whole table)
  @@index([actorId])
  @@index([actorBusinessId], where: raw("\"actorBusinessId\" IS NOT NULL"))
  // D156: foreign keys (deleting a post or comment removes its notifications).
  @@index([generalPostId], where: raw("\"generalPostId\" IS NOT NULL"))
  @@index([businessPostId], where: raw("\"businessPostId\" IS NOT NULL"))
  @@index([commentId], where: raw("\"commentId\" IS NOT NULL"))
  @@index([giveawayWinnerId], where: raw("\"giveawayWinnerId\" IS NOT NULL"))
  // P13.7: purge of read notifications
  @@index([readAt], where: raw("\"readAt\" IS NOT NULL"))
}

/// D90: Contact us. A support ticket or a general message, read in the admin portal.
enum ContactCategory {
  SUPPORT
  GENERAL
}

enum ContactStatus {
  OPEN
  RESOLVED
}

model ContactMessage {
  id             String          @id @default(uuid(7)) @db.Uuid
  userId         String?         @db.Uuid
  guestSessionId String?         @db.Uuid
  category       ContactCategory
  subject        String          @db.VarChar(100)
  body           String          @db.VarChar(2000)
  /// The person agreed that a moderator may see their account email to reply.
  allowReply     Boolean         @default(false)
  status         ContactStatus   @default(OPEN)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  resolvedAt     DateTime?       @db.Timestamptz(3)
  resolvedById   String?         @db.Uuid
  user           User?           @relation("ContactFrom", fields: [userId], references: [id], onDelete: Cascade)
  guestSession   GuestSession?   @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  resolvedBy     User?           @relation("ContactResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  // P13.1: foreign-key indexes (deletes of the parent row would otherwise read the whole table)
  @@index([guestSessionId])
  @@index([resolvedById])
}

/// D98: private messaging between two friends. One conversation per pair (ordered ids).
model Conversation {
  id            String               @id @default(uuid(7)) @db.Uuid
  userLowId     String               @db.Uuid
  userHighId    String               @db.Uuid
  /// This chat's data key, wrapped by the master key (like a user's, D35). Destroying it
  /// makes the chat unreadable.
  dekWrapped    Bytes
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  lastMessageAt DateTime             @default(now()) @db.Timestamptz(3)
  userLow       User                 @relation("ConversationLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh      User                 @relation("ConversationHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  members       ConversationMember[]
  messages      Message[]

  @@unique([userLowId, userHighId])
  @@index([userHighId])
}

model ConversationMember {
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  lastReadAt     DateTime?    @db.Timestamptz(3)
  /// "Delete chat for me": messages up to this time are hidden from this person.
  hiddenBefore   DateTime?    @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation("ConversationMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid(7)) @db.Uuid
  conversationId String        @db.Uuid
  senderId       String        @db.Uuid
  /// Text, encrypted with the conversation's key (empty for a photo-only message).
  bodyEnc        Bytes?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  /// "Unsend" (within 15 minutes): gone for both.
  unsentAt       DateTime?     @db.Timestamptz(3)
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  photos         Photo[]
  hiddenFor      MessageHide[]
  reports        Report[]

  @@index([senderId, createdAt])
  // P13.1: chat paging, matching its ORDER BY
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
}

/// "Delete for me" on one message.
model MessageHide {
  messageId String  @db.Uuid
  userId    String  @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation("MessageHidden", fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  // P13.1: foreign-key indexes (deletes of the parent row would otherwise read the whole table)
  @@index([userId])
}

/// D104: first-time guides an account has finished ("Got it"), and which version.
model GuideSeen {
  userId   String   @db.Uuid
  guideKey String   @db.VarChar(40)
  version  Int
  seenAt   DateTime @default(now()) @db.Timestamptz(3)
  user     User     @relation("GuidesSeen", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, guideKey])
}

model UserBlock {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// Every moderation decision: reason, time, admin, target (§10.3).
enum AutoSuspensionStatus {
  OPEN // waiting for a moderator
  CONFIRMED // a moderator banned the account
  RESTORED // a moderator lifted it; hidden posts came back
}

/// D74: an account suspended automatically because many different people reported it in a
/// short time. Remembers exactly which posts it hid, so a moderator can undo it cleanly.
model AutoSuspension {
  id                  String               @id @default(uuid(7)) @db.Uuid
  userId              String               @db.Uuid
  reporterCount       Int
  heldGeneralPostIds  String[]             @db.Uuid
  heldBusinessPostIds String[]             @db.Uuid
  status              AutoSuspensionStatus @default(OPEN)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  resolvedAt          DateTime?            @db.Timestamptz(3)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model ModerationAction {
  id                   String               @id @default(uuid(7)) @db.Uuid
  adminId              String               @db.Uuid
  action               ModerationActionType
  reason               String               @db.VarChar(1000)
  /// Internal only. Never in public responses.
  internalNote         String?              @db.VarChar(2000)
  durationHours        Int?
  expiresAt            DateTime?            @db.Timestamptz(3)
  targetUserId         String?              @db.Uuid
  targetGuestId        String?              @db.Uuid
  targetInstallationId String?              @db.Uuid
  /// D191: a strike (or note) on a business login. Never together with targetUserId.
  targetBusinessId     String?              @db.Uuid
  generalPostId        String?              @db.Uuid
  businessPostId       String?              @db.Uuid
  commentId            String?              @db.Uuid
  photoId              String?              @db.Uuid
  submissionId         String?              @db.Uuid
  reportId             String?              @db.Uuid
  /// P5.6/P5.7: a strike cancelled (e.g. after a successful appeal) no longer counts.
  voidedAt             DateTime?            @db.Timestamptz(3)
  voidedById           String?              @db.Uuid
  voidReason           String?              @db.VarChar(500)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  admin                User                 @relation("ModActor", fields: [adminId], references: [id])
  targetUser           User?                @relation("ModTargetUser", fields: [targetUserId], references: [id])
  targetBusiness       BusinessAccount?     @relation(fields: [targetBusinessId], references: [id], onDelete: Cascade)
  targetGuest          GuestSession?        @relation(fields: [targetGuestId], references: [id], onDelete: SetNull)
  targetInstallation   Installation?        @relation(fields: [targetInstallationId], references: [id])
  generalPost          GeneralPost?         @relation(fields: [generalPostId], references: [id], onDelete: SetNull)
  businessPost         BusinessPost?        @relation(fields: [businessPostId], references: [id], onDelete: SetNull)
  comment              Comment?             @relation(fields: [commentId], references: [id], onDelete: SetNull)
  photo                Photo?               @relation(fields: [photoId], references: [id], onDelete: SetNull)
  submission           BusinessSubmission?  @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  report               Report?              @relation(fields: [reportId], references: [id], onDelete: SetNull)
  appeals              Appeal[]

  @@index([targetUserId, createdAt])
  @@index([targetBusinessId, createdAt])
  @@index([targetGuestId])
  @@index([targetInstallationId])
  @@index([adminId, createdAt])
  // P13.1: foreign-key indexes (deletes of the parent row would otherwise read the whole table)
  @@index([generalPostId])
  @@index([businessPostId])
  @@index([commentId])
  @@index([photoId])
  @@index([reportId])
  @@index([submissionId])
}

model AdminAuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  adminId    String   @db.Uuid
  action     String   @db.VarChar(60)
  targetType String   @db.VarChar(40)
  targetId   String?  @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  admin      User     @relation(fields: [adminId], references: [id])

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

model AccountDeletion {
  id          String         @id @default(uuid(7)) @db.Uuid
  userId      String         @db.Uuid
  status      DeletionStatus @default(REQUESTED)
  requestedAt DateTime       @default(now()) @db.Timestamptz(3)
  /// When PII purge becomes due (requestedAt + retention, D14).
  purgeAfter  DateTime       @db.Timestamptz(3)
  completedAt DateTime?      @db.Timestamptz(3)
  user        User           @relation(fields: [userId], references: [id])

  @@index([status, purgeAfter])
  @@index([userId])
}

// ──────────────────────── Config & infrastructure ────────────────────────

/// Server-authoritative settings (§7, §18). Keys match CONFIG_DEFAULTS in @jax/shared.
enum AppealStatus {
  OPEN
  ACCEPTED
  REJECTED
}

/// P5.7: a request to cancel one strike (warning, suspension or ban). Accepting it voids
/// the strike, which also lifts the suspension or ban it caused.
model Appeal {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @db.Uuid
  actionId     String           @db.Uuid
  message      String           @db.VarChar(1000)
  status       AppealStatus     @default(OPEN)
  /// Shown to the user with the decision.
  decisionNote String?          @db.VarChar(500)
  decidedById  String?          @db.Uuid
  decidedAt    DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  user         User             @relation("Appellant", fields: [userId], references: [id], onDelete: Cascade)
  action       ModerationAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  /// One open appeal per action (was raw SQL; D109).
  @@unique([actionId], map: "Appeal_one_open_per_action", where: raw("status = 'OPEN'"))
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([actionId])
}

/// P5.4 text screening (§11.2): what happens when text matches a rule.
enum ScreeningAction {
  WARN // ask "post anyway?"
  HOLD // saved but hidden until a moderator reviews it
  BLOCK // refused
}

enum ScreeningMatch {
  WORD // whole words or phrases, after normalization
  CONTAINS // anywhere, ignoring spaces and punctuation (catches "k.i.l.l")
}

enum ScreeningCategory {
  SLUR
  THREAT
  SEXUAL
  HARASSMENT
  DOXXING
  SPAM
  OTHER
}

/// Configurable screening rules (P5.4). Edited by admins (P5.17); cached briefly.
model ScreeningRule {
  id        String            @id @default(uuid(7)) @db.Uuid
  /// The term or phrase as an admin typed it; matched after normalization.
  term      String            @db.VarChar(100)
  match     ScreeningMatch    @default(WORD)
  action    ScreeningAction
  category  ScreeningCategory
  /// Shown to the person when it matches (optional; a default is used otherwise).
  message   String?           @db.VarChar(300)
  enabled   Boolean           @default(true)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([term, match])
}

model AppConfiguration {
  key         String   @id @db.VarChar(80)
  value       Json
  description String?  @db.VarChar(300)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById], references: [id])

  // P13.1: foreign-key indexes (deletes of the parent row would otherwise read the whole table)
  @@index([updatedById])
}

/// Fixed-window rate-limit counters (D8).
model RateLimitCounter {
  key         String   @db.VarChar(200)
  windowStart DateTime @db.Timestamptz(3)
  count       Int      @default(0)
  expiresAt   DateTime @db.Timestamptz(3)

  @@id([key, windowStart])
  @@index([expiresAt])
}

// ───────────────────── D116: anonymous area statistics ─────────────────────
// "Count, don't record": per-person rows exist only until their week and month are counted,
// carry no account ID and no coordinates, and become unlinkable when the period's key is
// destroyed. Everything kept long-term is a count.

/// Census 2020 ZIP Code Tabulation Areas around Duval (public domain), for area counts.
model ZipArea {
  zip  String                                        @id @db.Char(5)
  geom Unsupported("geography(MultiPolygon, 4326)")?

  @@index([geom], type: Gist)
}

/// The secret key for one week ("week:2026-10-19") or month ("month:2026-10"), wrapped by the
/// master key. Deleted (destroyed) once that period is counted.
model VisitKey {
  period     String   @id @db.VarChar(20)
  keyWrapped Bytes
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
}

/// One person seen in one ZIP on one local day (scratch, deleted after counting). The visitor
/// codes are keyed hashes of the account ID (16 bytes), never the ID.
model AreaVisit {
  day          DateTime @db.Date
  zip          String   @db.Char(5)
  visitorMonth Bytes
  visitorWeek  Bytes
  /// Parts of the day seen: 1 morning (6–12), 2 afternoon (12–17), 4 evening (17–22), 8 night.
  dayparts     Int      @db.SmallInt

  @@id([day, zip, visitorMonth])
}

/// Distinct people per ZIP per local day, and per part of the day.
model AreaStatsDaily {
  day          DateTime @db.Date
  zip          String   @db.Char(5)
  visitors     Int
  morning      Int
  afternoon    Int
  evening      Int
  night        Int
  /// Seen in this ZIP for the first time this month.
  newThisMonth Int

  @@id([day, zip])
}

/// Distinct people per ZIP per week (Monday start).
model AreaStatsWeekly {
  weekStart DateTime @db.Date
  zip       String   @db.Char(5)
  visitors  Int

  @@id([weekStart, zip])
}

/// Distinct people per ZIP per month, and their visit-days (visitDays / visitors = average days).
model AreaStatsMonthly {
  month     DateTime @db.Date
  zip       String   @db.Char(5)
  visitors  Int
  visitDays Int

  @@id([month, zip])
}

/// People seen in both ZIPs on the same day ("also visited"), zipA < zipB.
model AreaFlowDaily {
  day      DateTime @db.Date
  zipA     String   @db.Char(5)
  zipB     String   @db.Char(5)
  visitors Int

  @@id([day, zipA, zipB])
}

/// Activity at a place per local day, from location-verified posts and comments, favorites and
/// votes. Places of worship are never included.
model PlaceStatsDaily {
  day       DateTime      @db.Date
  placeId   String        @db.Uuid
  posts     Int
  comments  Int
  /// Distinct people who posted or commented there (both need you within 528 yd).
  people    Int
  favorites Int
  votes     Int
  place     BusinessPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([day, placeId])
  @@index([placeId])
}

/// Which days, weeks and months have been counted (so the job never counts twice).
model StatsRollup {
  kind   String   @db.VarChar(10)
  period DateTime @db.Date

  @@id([kind, period])
}

/// D124: how a poll is answered.
enum PollKind {
  YES_NO // Yes / No (and optionally "Not sure")
  SINGLE // pick one
  MULTI // pick several (all that apply, or up to maxPicks)
  SCALE // rating 1–5
}

/// D123 / D124: a weekly poll, written by an admin. Editable only before `opensAt`.
model Poll {
  id             String           @id @default(uuid(7)) @db.Uuid
  kind           PollKind         @default(SINGLE)
  /// A key from POLL_TOPICS in @jax/shared (e.g. "prices").
  topic          String           @default("other") @db.VarChar(30)
  question       String           @db.VarChar(200)
  /// Optional context under the question (neutral wording).
  details        String?          @db.VarChar(500)
  /// MULTI: the most answers one person may pick (null = any number).
  maxPicks       Int?             @db.SmallInt
  /// SCALE: the words for 1 and 5.
  scaleLowLabel  String?          @db.VarChar(40)
  scaleHighLabel String?          @db.VarChar(40)
  opensAt        DateTime         @db.Timestamptz(3)
  closesAt       DateTime         @db.Timestamptz(3)
  createdById    String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  /// Set once the votes are counted and the key destroyed (after closing).
  finalizedAt    DateTime?        @db.Timestamptz(3)
  /// D150: an admin made this the Poll of the week (Home shows the newest featured open poll).
  featuredAt     DateTime?        @db.Timestamptz(3)
  /// How many people voted (filled when finalized).
  voterCount     Int              @default(0)
  createdBy      User?            @relation("PollCreator", fields: [createdById], references: [id], onDelete: SetNull)
  choices        PollChoice[]
  key            PollKey?
  voters         PollVoter[]
  tallies        PollTally[]
  voterTallies   PollVoterTally[]

  @@index([opensAt, closesAt])
  @@index([finalizedAt, closesAt])
  @@index([topic, closesAt])
  @@index([createdById])
}

model PollChoice {
  id         String          @id @default(uuid(7)) @db.Uuid
  pollId     String          @db.Uuid
  label      String          @db.VarChar(80)
  position   Int             @db.SmallInt
  /// SCALE: the number this answer stands for (1–5).
  value      Int?            @db.SmallInt
  poll       Poll            @relation(fields: [pollId], references: [id], onDelete: Cascade)
  selections PollSelection[]
  tallies    PollTally[]

  @@unique([pollId, position])
}

/// D123: the poll's own secret key (wrapped by the master key). Destroyed when the poll is
/// counted; after that the coded votes (already deleted) could not be linked to anyone.
model PollKey {
  pollId     String   @id @db.Uuid
  keyWrapped Bytes
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  poll       Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
}

/// D124: one person who voted, while the poll is open: a code from the account ID and the
/// poll key (never the ID) and their ZIP code. No time. The primary key blocks a second vote.
/// Deleted when the poll is counted.
model PollVoter {
  pollId     String          @db.Uuid
  voterCode  Bytes
  zip        String          @default("") @db.VarChar(5)
  poll       Poll            @relation(fields: [pollId], references: [id], onDelete: Cascade)
  selections PollSelection[]

  @@id([pollId, voterCode])
}

/// D124: one answer a voter picked (several for Pick several). Deleted with the voter.
model PollSelection {
  pollId    String     @db.Uuid
  voterCode Bytes
  choiceId  String     @db.Uuid
  voter     PollVoter  @relation(fields: [pollId, voterCode], references: [pollId, voterCode], onDelete: Cascade)
  choice    PollChoice @relation(fields: [choiceId], references: [id], onDelete: Cascade)

  @@id([pollId, voterCode, choiceId])
  @@index([choiceId])
}

/// D123: after closing, how many picked each answer in each ZIP ("" = outside every ZIP area).
model PollTally {
  pollId   String     @db.Uuid
  choiceId String     @db.Uuid
  zip      String     @default("") @db.VarChar(5)
  count    Int
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  choice   PollChoice @relation(fields: [choiceId], references: [id], onDelete: Cascade)

  @@id([pollId, choiceId, zip])
  @@index([choiceId])
}

/// D124: after closing, how many people voted in each ZIP (the base for percentages).
model PollVoterTally {
  pollId String @db.Uuid
  zip    String @default("") @db.VarChar(5)
  voters Int
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@id([pollId, zip])
}

/// D125: where a citywide topic stands.
enum CityTopicStatus {
  SUGGESTED // from a user, waiting for the admin (D125; no longer used by the app, D133)
  ACTIVE // shown (between opensAt and closesAt)
  CLOSED // ended by the admin; readable, no new posts
  REJECTED // a suggestion the admin turned down
  REMOVED // D133: taken down by a moderator (hidden; can be restored)
  HELD // D134: hidden after many reports, waiting for a moderator
  DELETED // D134: deleted by its creator; the admin sees it for a week, then it's purged
}

/// D133: a topic for all of Duval, or one tied to a spot (seen within half a mile of it).
enum TopicScope {
  CITY
  LOCAL
}

/// D125: a citywide discussion topic (all of Duval, no radius).
model CityTopic {
  id             String                                 @id @default(uuid(7)) @db.Uuid
  title          String                                 @db.VarChar(80)
  /// D131: a key from TOPIC_CATEGORIES in @jax/shared (the same list as poll topics).
  category       String                                 @default("other") @db.VarChar(30)
  description    String?                                @db.VarChar(500)
  /// D133: CITY (all of Duval) or LOCAL (within topics.localRadiusMiles of `location`).
  scope          TopicScope                             @default(CITY)
  /// D133: a local topic's spot (coarsened like posts, D7); null for city topics.
  location       Unsupported("geography(Point, 4326)")?
  /// D134: the creator chose to show their username on the topic (off by default).
  showCreator    Boolean                                @default(false)
  /// D134: when the creator deleted it (purged with its posts after topics.deletedKeepDays).
  deletedAt      DateTime?                              @db.Timestamptz(3)
  status         CityTopicStatus                        @default(ACTIVE)
  pinned         Boolean                                @default(false)
  /// Shown from this time (a scheduled topic, e.g. a game day).
  opensAt        DateTime                               @default(now()) @db.Timestamptz(3)
  /// Ends automatically at this time (optional).
  closesAt       DateTime?                              @db.Timestamptz(3)
  suggestedById  String?                                @db.Uuid
  createdById    String?                                @db.Uuid
  /// Why a suggestion was turned down (shown to the person who suggested it).
  decisionReason String?                                @db.VarChar(300)
  decidedAt      DateTime?                              @db.Timestamptz(3)
  createdAt      DateTime                               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                               @updatedAt @db.Timestamptz(3)
  suggestedBy    User?                                  @relation("TopicSuggester", fields: [suggestedById], references: [id], onDelete: SetNull)
  createdBy      User?                                  @relation("TopicCreator", fields: [createdById], references: [id], onDelete: SetNull)
  posts          GeneralPost[]
  follows        TopicFollow[]
  reports        Report[]

  @@index([location], type: Gist)
  @@index([scope, status, opensAt])
  @@index([status, pinned, opensAt])
  @@index([category, status])
  @@index([suggestedById, createdAt])
  @@index([createdById])
}

/// D133: someone following a topic (shown in their Following list; no notifications yet).
model TopicFollow {
  userId    String    @db.Uuid
  topicId   String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     CityTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@index([topicId])
}

enum PollSuggestionStatus {
  WAITING
  USED // the admin turned it into a poll
  REJECTED
}

/// D133: a poll question suggested by a user; the admin uses it for a poll or turns it down.
model PollSuggestion {
  id             String               @id @default(uuid(7)) @db.Uuid
  userId         String?              @db.Uuid
  question       String               @db.VarChar(200)
  details        String?              @db.VarChar(500)
  /// A key from POLL_TOPICS.
  topic          String               @default("other") @db.VarChar(30)
  status         PollSuggestionStatus @default(WAITING)
  decisionReason String?              @db.VarChar(300)
  decidedAt      DateTime?            @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ───────────────────── Business portal (D169, Phase 16) ─────────────────────
// Owned and used only by apps/business. A business account has no link to a personal User.

/// A business sign-in (the owner or an employee). Roles are per place (BusinessPlaceAccess).
/// Owners sign in with an email; employees the owner creates sign in with a username
/// (CHECK: at least one of the two).
model BusinessAccount {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /// Lower-cased. Plain text by the owner's choice (Q32); never in a public response.
  email              String?   @unique @db.VarChar(254)
  /// Employees only; lower-cased.
  username           String?   @unique @db.VarChar(40)
  passwordHash       String
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime? @db.Timestamptz(3)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)
  /// Optional two-factor (B1.2): the authenticator secret, encrypted; on once confirmed.
  totpSecretEnc      String?
  totpEnabledAt      DateTime? @db.Timestamptz(3)
  totpLastStep       BigInt?
  /// The Owner account that created this employee login; null for owners.
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  /// A JaxSide admin suspended the account (B1.7); sign-in refused until lifted.
  suspendedAt        DateTime? @db.Timestamptz(3)
  /// Revoked by its Owner or an admin; never signs in again.
  revokedAt          DateTime? @db.Timestamptz(3)
  /// D185: the Google account ID ("sub") for Sign in with Google (owners only). A login that
  /// only ever uses Google gets a random, unusable passwordHash.
  googleSub          String?   @unique @db.VarChar(255)
  /// B1.8: email a summary of new activity (at most once a day; needs an email).
  emailNotices       Boolean   @default(false)
  /// D191: a strike's suspension; sign-in refused until then (an admin's open-ended
  /// suspension stays in suspendedAt).
  suspendedUntil     DateTime? @db.Timestamptz(3)
  /// D189: the login's profile picture (an uploaded image, shown next to what it writes).
  avatarMediaId      String?   @unique @db.Uuid
  noticesEmailedAt   DateTime? @db.Timestamptz(3)

  createdBy            BusinessAccount?              @relation("BusinessEmployees", fields: [createdById], references: [id], onDelete: SetNull)
  employees            BusinessAccount[]             @relation("BusinessEmployees")
  sessions             BusinessSession[]
  placeAccess          BusinessPlaceAccess[]         @relation("AccessHolder")
  accessGranted        BusinessPlaceAccess[]         @relation("AccessGranter")
  invitesUsed          BusinessInvite[]
  subscriptions        Subscription[]
  verificationRequests BusinessVerificationRequest[]
  ads                  Ad[]                          @relation("AdOwner")
  adsCreated           Ad[]                          @relation("AdCreator")
  media                AdMedia[]                     @relation("MediaOwner")
  avatarMedia          AdMedia?                      @relation("BusinessAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  /// D191: strikes and notes on this login.
  modActions           ModerationAction[]
  /// D194: reports this login filed in its places' discussions.
  reportsFiled         Report[]                      @relation("BusinessReporter")
  // D172: what the business wrote in its place's discussion (the real author, for the Owner).
  posts                BusinessPost[]
  comments             Comment[]
  notifications        Notification[]
  notices              BusinessNotice[]

  @@index([createdById])
}

/// A cookie session on the business website (same shape as admin sessions, D3).
model BusinessSession {
  id            String          @id @default(uuid(7)) @db.Uuid
  tokenHash     String          @unique @db.Char(64)
  csrfTokenHash String          @db.Char(64)
  accountId     String          @db.Uuid
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  lastUsedAt    DateTime        @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime        @db.Timestamptz(3)
  revokedAt     DateTime?       @db.Timestamptz(3)
  account       BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt])
  @@index([expiresAt])
}

enum BusinessRole {
  OWNER // billing, ads, team, everything
  MANAGER // posts, replies, drafts ads
  STAFF // posts, replies
}

/// Who can run which place, and as what. One live Owner per place (partial unique index).
model BusinessPlaceAccess {
  id             String                @id @default(uuid(7)) @db.Uuid
  accountId      String                @db.Uuid
  placeId        String                @db.Uuid
  role           BusinessRole
  /// D157: shown after "The Owner" on posts ("The Owner · Sarah"); optional.
  staffName      String?               @db.VarChar(30)
  /// B1.3: the verified phone-app claim this Owner access came from.
  ownerClaimId   String?               @db.Uuid
  grantedById    String?               @db.Uuid
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime?             @db.Timestamptz(3)
  /// B1.8: this person's inbox shows the place's activity after this (null = since they joined).
  inboxSeenAt    DateTime?             @db.Timestamptz(3)
  /// D185: how this Owner access was verified (Owner rows only; null for Manager / Staff).
  verifiedBy     BusinessVerification?
  verifiedAt     DateTime?             @db.Timestamptz(3)
  /// D185: the Google Business Profile listing it was verified with ("locations/…").
  googleLocation String?               @db.VarChar(200)
  account        BusinessAccount       @relation("AccessHolder", fields: [accountId], references: [id], onDelete: Cascade)
  place          BusinessPlace         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  ownerClaim     OwnerClaim?           @relation(fields: [ownerClaimId], references: [id], onDelete: SetNull)
  grantedBy      BusinessAccount?      @relation("AccessGranter", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([accountId, placeId], map: "BusinessPlaceAccess_one_live", where: raw("\"revokedAt\" IS NULL"))
  @@unique([placeId], map: "BusinessPlaceAccess_one_owner", where: raw("role = 'OWNER' AND \"revokedAt\" IS NULL"))
  @@index([placeId, revokedAt])
  @@index([ownerClaimId])
  @@index([grantedById])
}

/// B1.3: the emailed link that lets a verified claimant create their business account.
model BusinessInvite {
  id              String           @id @default(uuid(7)) @db.Uuid
  tokenHash       String           @unique @db.Char(64)
  placeId         String           @db.Uuid
  ownerClaimId    String           @db.Uuid
  expiresAt       DateTime         @db.Timestamptz(3)
  usedAt          DateTime?        @db.Timestamptz(3)
  usedByAccountId String?          @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  place           BusinessPlace    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  ownerClaim      OwnerClaim       @relation(fields: [ownerClaimId], references: [id], onDelete: Cascade)
  usedBy          BusinessAccount? @relation(fields: [usedByAccountId], references: [id], onDelete: SetNull)

  @@index([ownerClaimId])
  @@index([placeId])
  @@index([usedByAccountId])
  @@index([expiresAt])
}

/// D168: a subscription plan, edited by an admin. Prices are open (Q28).
model Plan {
  id               String         @id @default(uuid(7)) @db.Uuid
  name             String         @unique @db.VarChar(60)
  /// Ads live at once (CHECK 0..3, D167).
  liveAdLimit      Int            @db.SmallInt
  /// Monthly price in cents; null until prices are decided (Q28).
  priceCents       Int?
  /// Q29: whether the plan includes area counts (insights).
  includesInsights Boolean        @default(false)
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  subscriptions    Subscription[]
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

/// D168: a business's plan. `comped` = a free promo period an admin granted (no payment).
model Subscription {
  id               String             @id @default(uuid(7)) @db.Uuid
  accountId        String             @db.Uuid
  planId           String             @db.Uuid
  status           SubscriptionStatus @default(ACTIVE)
  startsAt         DateTime           @db.Timestamptz(3)
  /// Null = open-ended.
  endsAt           DateTime?          @db.Timestamptz(3)
  comped           Boolean            @default(false)
  /// The JaxSide admin (User id) who granted a comp; a plain id kept for the record.
  grantedByAdminId String?            @db.Uuid
  note             String?            @db.VarChar(300)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  account          BusinessAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan             Plan               @relation(fields: [planId], references: [id])

  /// One active subscription per business.
  @@unique([accountId], map: "Subscription_one_active", where: raw("status = 'ACTIVE'"))
  @@index([planId])
}

enum AdTemplate {
  BANNER // between two posts
  POST // looks like a post
  FEATURE // large
}

/// D171: stored approval states. "Scheduled" and "Live" are worked out from the time
/// window of an APPROVED ad, so no background job has to flip them.
enum AdStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PAUSED
  ENDED
}

/// Ad image or GIF uploaded by a business account (Photo needs a personal uploader).
model AdMedia {
  id            String           @id @default(uuid(7)) @db.Uuid
  accountId     String           @db.Uuid
  storageKey    String?          @unique @db.VarChar(200)
  quarantineKey String?          @unique @db.VarChar(200)
  status        PhotoStatus      @default(PENDING_UPLOAD)
  mimeType      String?          @db.VarChar(40)
  width         Int?
  height        Int?
  bytes         Int?
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  processedAt   DateTime?        @db.Timestamptz(3)
  removedAt     DateTime?        @db.Timestamptz(3)
  account       BusinessAccount  @relation("MediaOwner", fields: [accountId], references: [id], onDelete: Cascade)
  ads           Ad[]
  /// D189: the login using this image as its profile picture.
  avatarOf      BusinessAccount? @relation("BusinessAvatar")

  @@index([accountId, createdAt])
  @@index([status, createdAt])
}

/// D166/D167: an ad in a business's library (at most 20 per business, B3.2).
model Ad {
  id            String           @id @default(uuid(7)) @db.Uuid
  accountId     String           @db.Uuid
  /// The place the ad promotes (one the business runs).
  placeId       String           @db.Uuid
  status        AdStatus         @default(DRAFT)
  template      AdTemplate
  headline      String           @db.VarChar(80)
  body          String?          @db.VarChar(500)
  mediaId       String?          @db.Uuid
  /// Q30: alcohol deals carry a "21+" line.
  adultsOnly    Boolean          @default(false)
  startsAt      DateTime?        @db.Timestamptz(3)
  endsAt        DateTime?        @db.Timestamptz(3)
  /// Days it runs: bit 0 = Sunday … bit 6 = Saturday (127 = every day; CHECK 1..127).
  daysOfWeek    Int              @default(127) @db.SmallInt
  /// Time of day in Jacksonville local minutes (0..1440); both null = all day.
  dailyStartMin Int?             @db.SmallInt
  dailyEndMin   Int?             @db.SmallInt
  /// Targeting (B3.4): a radius around the place and/or chosen ZIP codes.
  radiusMeters  Int?
  zips          String[]         @db.VarChar(5)
  createdById   String?          @db.Uuid
  submittedAt   DateTime?        @db.Timestamptz(3)
  approvedAt    DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  account       BusinessAccount  @relation("AdOwner", fields: [accountId], references: [id], onDelete: Cascade)
  createdBy     BusinessAccount? @relation("AdCreator", fields: [createdById], references: [id], onDelete: SetNull)
  place         BusinessPlace    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  media         AdMedia?         @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  reviews       AdReview[]
  dailyStats    AdDailyStats[]

  @@index([accountId, status])
  @@index([status, startsAt, endsAt])
  @@index([placeId])
  @@index([mediaId])
  @@index([createdById])
}

enum AdDecision {
  APPROVED
  REJECTED
}

/// B3.3: an admin's decision on a submitted ad, with what the ad said at the time.
model AdReview {
  id        String     @id @default(uuid(7)) @db.Uuid
  adId      String     @db.Uuid
  /// The JaxSide admin (User id); a plain id kept for the record.
  adminId   String     @db.Uuid
  decision  AdDecision
  /// Shown to the business when an ad is turned down.
  reason    String?    @db.VarChar(500)
  snapshot  Json
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  ad        Ad         @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, createdAt])
}

/// B3.5: totals per ad per day (never one row per view, never who).
model AdDailyStats {
  adId          String   @db.Uuid
  day           DateTime @db.Date
  views         Int      @default(0)
  interested    Int      @default(0)
  notInterested Int      @default(0)
  ad            Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@id([adId, day])
}

enum BusinessNoticeKind {
  PLACE_ADDED // a place was added to the account (invite, or moved by an admin)
  PLACE_REMOVED // the account lost a place (moved by an admin, Owner tag removed)
  AD_APPROVED // B3.3
  AD_REJECTED // B3.3
  FROM_JAXSIDE // anything else an admin tells the business
  STRIKE // D191: a strike on this login (or, for the Owner, on one of its employees)
}

/**
 * B1.8: a message from JaxSide to a business login, shown in its inbox. The place's own
 * activity (new posts and comments) isn't stored here: the inbox works it out from the
 * discussion tables, so the app never has to write anything for it.
 */
model BusinessNotice {
  id        String             @id @default(uuid(7)) @db.Uuid
  accountId String             @db.Uuid
  placeId   String?            @db.Uuid
  kind      BusinessNoticeKind
  title     String             @db.VarChar(120)
  body      String?            @db.VarChar(500)
  /// A page on the business website (a path such as /places/…), never an outside link.
  link      String?            @db.VarChar(300)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  readAt    DateTime?          @db.Timestamptz(3)
  account   BusinessAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  place     BusinessPlace?     @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([accountId], where: raw("\"readAt\" IS NULL"))
  @@index([placeId])
}

/// D180: a sign-in burst that tripped the one-minute blocker (5 wrong passwords for one account,
/// or 8 from one place, in a minute). For the admin dashboard; kept 90 days. `ipCode` is the
/// first characters of the keyed IP hash (never the address).
model SecurityEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  kind      String   @db.VarChar(40)
  userId    String?  @db.Uuid
  ipCode    String?  @db.VarChar(16)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([kind, createdAt])
  @@index([userId])
}

/// D185: how a business's Owner access to a place was verified.
enum BusinessVerification {
  GOOGLE // the owner's Google account manages the place's Google Business Profile listing
  ADMIN // a JaxSide admin verified them (the "Ask JaxSide to verify me" fallback, or a move)
  LEGACY_CLAIM // verified in the phone app before D185 (email / website / phone code)
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/**
 * D185: "Ask JaxSide to verify me", for owners who can't verify with Google. Sent from the
 * owner website by a signed-in business account; lands in the admin portal's Owners queue.
 * `placeId` is set for a place already in the directory; a brand-new place has only the
 * name and address the owner typed (the admin adds the place, then approves).
 */
model BusinessVerificationRequest {
  id               String                    @id @default(uuid(7)) @db.Uuid
  accountId        String                    @db.Uuid
  placeId          String?                   @db.Uuid
  placeName        String                    @db.VarChar(200)
  placeAddress     String?                   @db.VarChar(300)
  /// How the admin reaches the person (they choose; nothing else is asked).
  contactName      String                    @db.VarChar(100)
  contactPhone     String?                   @db.VarChar(40)
  note             String?                   @db.VarChar(1000)
  status           VerificationRequestStatus @default(PENDING)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  decidedAt        DateTime?                 @db.Timestamptz(3)
  /// The admin (User id); a plain id kept for the record.
  decidedByAdminId String?                   @db.Uuid
  /// Shown to the business when a request is turned down.
  decisionNote     String?                   @db.VarChar(500)
  account          BusinessAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  place            BusinessPlace?            @relation(fields: [placeId], references: [id], onDelete: SetNull)

  /// One open request per business and place.
  @@unique([accountId, placeId], map: "BusinessVerificationRequest_one_open", where: raw("status = 'PENDING'"))
  @@index([status, createdAt])
  @@index([accountId])
  @@index([placeId])
}

// ───────────────────────────── Giveaways (D188) ─────────────────────────────

/// D188: a day (Jacksonville time) a signed-in person used the app; giveaway tickets.
/// One row per person per day, nothing else (no times, places or screens). Deleted with the
/// account and after `retention.activeDayDays`.
model UserActiveDay {
  userId String   @db.Uuid
  day    DateTime @db.Date
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

enum GiveawayStatus {
  ACTIVE
  CANCELLED
}

/// D188: how a giveaway's winners are chosen.
enum GiveawayPick {
  RANDOM
  MANUAL
}

enum GiveawayWinnerStatus {
  /// Told in the app; waiting for their answer until `respondBy`.
  NOTIFIED
  /// Said yes: the prize goes to the email on their account.
  ACCEPTED
  DECLINED
  /// No answer by `respondBy`.
  EXPIRED
  PRIZE_SENT
  /// Removed by the admin (e.g. found ineligible); the slot can be drawn again.
  DISQUALIFIED
}

/// D188: a giveaway run from the admin portal. Criteria are optional and measured over the
/// entry period (startsAt to endsAt); accounts must always be ACTIVE users (never admins).
model Giveaway {
  id                    String           @id @default(uuid(7)) @db.Uuid
  title                 String           @db.VarChar(100)
  /// Shown to the winner ("$25 Amazon gift card").
  prize                 String           @db.VarChar(200)
  /// Admins only.
  notes                 String?          @db.VarChar(2000)
  startsAt              DateTime         @db.Timestamptz(3)
  endsAt                DateTime         @db.Timestamptz(3)
  pickMethod            GiveawayPick
  winnerCount           Int              @db.SmallInt
  /// Days a winner has to accept.
  respondDays           Int              @default(5) @db.SmallInt
  // Criteria (null = not used)
  minPosts              Int?             @db.SmallInt
  minPostDays           Int?             @db.SmallInt
  minComments           Int?             @db.SmallInt
  minApprovedPlaces     Int?             @db.SmallInt
  requireConfirmedEmail Boolean          @default(true)
  requireNoStrikes      Boolean          @default(false)
  joinedAfter           DateTime?        @db.Timestamptz(3)
  joinedBefore          DateTime?        @db.Timestamptz(3)
  /// Account at least this many days old when the entry period ends.
  minAccountAgeDays     Int?             @db.SmallInt
  /// Opened the app (signed in) on at least this many days in the entry period.
  minActiveDays         Int?             @db.SmallInt
  /// D188: the random draw gives one ticket per day they opened the app in the entry period.
  ticketsPerActiveDay   Boolean          @default(false)
  excludePastWinners    Boolean          @default(false)
  status                GiveawayStatus   @default(ACTIVE)
  createdById           String           @db.Uuid
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)
  createdBy             User             @relation("GiveawayCreator", fields: [createdById], references: [id])
  winners               GiveawayWinner[]

  @@index([createdAt])
  @@index([createdById])
}

/// D188: one picked winner. The email is only ever read after they accept (reveal, audited).
model GiveawayWinner {
  id              String               @id @default(uuid(7)) @db.Uuid
  giveawayId      String               @db.Uuid
  userId          String               @db.Uuid
  status          GiveawayWinnerStatus @default(NOTIFIED)
  pickedBy        GiveawayPick
  /// How many accounts were eligible when this winner was picked (a record of the draw).
  poolSize        Int
  /// D188: this winner's tickets and the pool's total, when the draw was weighted.
  tickets         Int?
  poolTickets     Int?
  pickedById      String               @db.Uuid
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  respondBy       DateTime             @db.Timestamptz(3)
  respondedAt     DateTime?            @db.Timestamptz(3)
  emailRevealedAt DateTime?            @db.Timestamptz(3)
  prizeSentAt     DateTime?            @db.Timestamptz(3)
  /// Admins only (e.g. the gift card order number, or why they were disqualified).
  adminNote       String?              @db.VarChar(500)
  giveaway        Giveaway             @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user            User                 @relation("GiveawayWins", fields: [userId], references: [id], onDelete: Cascade)
  pickedByUser    User                 @relation("GiveawayPicker", fields: [pickedById], references: [id])
  notifications   Notification[]

  @@unique([giveawayId, userId])
  @@index([userId])
  @@index([pickedById])
}
