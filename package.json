{
  "name": "jax-app",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @jax/server",
    "dev:mobile": "node scripts/dev-mobile-note.mjs && npm run start -w @jax/mobile",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build -w @jax/server",
    "dev:remote": "node scripts/dev-remote.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "cloudflared": "^0.7.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
